# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 GitHub에 올리지 마세요)
# 비워 두면: DB는 local.db(SQLite), AI는 예시 레시피·예시 재료 인식, 안전 검사는 기본 수치(임시값)로 동작해요.
DATABASE_URL=
JWT_SECRET=아무도-모르는-긴-문자열
OPENAI_API_KEY=
# 코디세이 키를 쓰면: OPENAI_BASE_URL=https://copa.codyssey.kr/v1 , OPENAI_MODEL=gpt-5.4-mini , OPENAI_VISION=false
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION=true
# 사진 재료 인식만 다른 서버로 (예: Google Gemini). 비우면 위 OPENAI_* 설정을 써요
VISION_API_KEY=
VISION_BASE_URL=
OPENAI_VISION_MODEL=
VISION_FALLBACK_MODELS=
# AI 레시피 요리 사진 (그림 모델). 끄려면 IMAGE_ENABLED=false
IMAGE_ENABLED=true
IMAGE_MODEL=gpt-image-2
MFDS_API_KEY=
CORS_ORIGINS=*
