# 이 파일을 .env 로 복사한 뒤 값을 채우세요.   (.env 는 절대 GitHub에 올리지 마세요!)
# 배포(Render)에서는 이 파일 대신 Render 의 Environment 화면에 같은 이름으로 넣어요.

# Supabase 대시보드 → Project Settings → API (또는 Data API / API Keys)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 공개 가능한 키: anon (또는 publishable) 키
SUPABASE_ANON_KEY=
# 비밀 키: service_role (또는 secret) 키. 계정 삭제에만 쓰여요. 프론트엔드·GitHub·채팅방에 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# 건강 정보 암호화 키. 아래 명령으로 한 번 만들고, 안전한 곳에 따로 보관하세요(잃어버리면 저장된 건강 정보를 복구할 수 없어요)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALTH_DATA_KEY=

# 프론트엔드 주소만 허용 (쉼표로 구분). 개발 중에는 * 로 두고, 배포 후 Vercel 주소로 바꾸세요
CORS_ORIGINS=*

# 동의 문구(약관)를 바꿀 때 함께 바꾸는 버전 이름
POLICY_VERSION=2026-10-19
